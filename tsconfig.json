{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/anthropic_readiness/resources/**/*.js",
    "tests/frontend/**/*.js",
    "tests/browser/**/*.js",
    "playwright.config.js"
  ]
}
