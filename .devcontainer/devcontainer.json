{
  "name": "Anthropic Readiness",
  "build": {"dockerfile": "../Dockerfile", "context": "..", "target": "dev"},
  "workspaceFolder": "/workspaces/anthropic-readiness",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/anthropic-readiness,type=bind",
  "remoteUser": "developer",
  "updateRemoteUserUID": true,
  "postCreateCommand": "uv sync --locked && npm ci --ignore-scripts && npx --no-install playwright install chromium",
  "customizations": {
    "vscode": {"extensions": ["ms-python.python", "charliermarsh.ruff"]}
  }
}
