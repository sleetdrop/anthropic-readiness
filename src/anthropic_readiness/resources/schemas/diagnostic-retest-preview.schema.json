{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anthropic-readiness:diagnostic-retest-preview:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "retest_preview"
    },
    "baseline": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "baseline_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          },
          "required": [
            "baseline_id",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "required": {
                "type": "boolean"
              },
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "required"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "version",
              "required",
              "assertions"
            ],
            "additionalProperties": false
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "version",
              "cases"
            ],
            "additionalProperties": false
          }
        },
        "actual_requests": {
          "type": "integer",
          "minimum": 0
        },
        "planned_requests": {
          "type": "integer",
          "minimum": 0
        },
        "limits": {
          "type": "object"
        },
        "repeat": {
          "const": 1
        },
        "retry": {
          "const": 0
        },
        "config_fingerprint": {
          "type": "string"
        },
        "test_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "cases",
        "profiles",
        "actual_requests",
        "planned_requests",
        "limits",
        "repeat",
        "retry",
        "config_fingerprint",
        "test_fingerprint"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "comparable": {
          "type": "boolean"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          },
          "uniqueItems": true
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "comparable",
        "changes",
        "reasons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "baseline",
    "plan",
    "conditions"
  ],
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "required",
        "assertions"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "before": {},
        "after": {},
        "kind": {
          "enum": [
            "context",
            "semantic"
          ]
        }
      },
      "required": [
        "field",
        "before",
        "after",
        "kind"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "enum": [
            "protocol",
            "behavior",
            "client",
            "environment"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version",
        "category",
        "required"
      ],
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "semantic_revision": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "object",
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^3\\.[0-9]+$"
            }
          },
          "required": [
            "implementation",
            "version"
          ],
          "additionalProperties": false
        },
        "file_hashes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "dependencies": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "semantic_revision",
        "python",
        "file_hashes",
        "dependencies",
        "content_sha256"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "connect_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "read_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "attempt_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "run_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_event_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_events": {
          "type": "integer",
          "minimum": 1
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "connect_timeout_s",
        "read_timeout_s",
        "attempt_timeout_s",
        "run_timeout_s",
        "max_response_bytes",
        "max_event_bytes",
        "max_events",
        "max_requests",
        "max_tokens"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "cases"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "contract": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "content_sha256"
          ],
          "additionalProperties": false
        },
        "protocol": {
          "type": "object",
          "properties": {
            "name": {
              "const": "anthropic.messages"
            },
            "api_version": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "beta_headers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "name",
            "api_version",
            "beta_headers"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "requested": {
              "type": "string",
              "minLength": 1
            },
            "policy": {
              "enum": [
                "request_or_alias",
                "structure_only"
              ]
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "requested",
            "policy",
            "aliases"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "repeat": {
          "const": 1
        },
        "retry": {
          "const": 0
        }
      },
      "required": [
        "schema_version",
        "content_sha256",
        "implementation",
        "contract",
        "protocol",
        "model",
        "capabilities",
        "limits",
        "profiles",
        "cases",
        "requests",
        "repeat",
        "retry"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "const": "POST"
        },
        "headers": {
          "type": "object",
          "properties": {
            "content-type": {
              "type": "string",
              "minLength": 1
            },
            "accept": {
              "type": "string",
              "minLength": 1
            },
            "anthropic-version": {
              "type": "string",
              "minLength": 1
            },
            "anthropic-beta": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "body": {
          "type": "object"
        },
        "streaming": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "case_id",
        "method",
        "headers",
        "body",
        "streaming",
        "sha256"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "assessment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "result_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "assessment_id",
        "result_sha256",
        "checkpoint_sha256",
        "recipe_sha256",
        "context_sha256"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "result_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "properties": {
            "checkpoint_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "enum": [
            "protocol",
            "behavior",
            "client",
            "environment"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "SKIP",
            "BLOCKED",
            "INDETERMINATE"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "event": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "pointer": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "event",
              "pointer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "version",
        "category",
        "required",
        "status",
        "reason_code",
        "expected",
        "actual",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "event",
        "pointer"
      ],
      "additionalProperties": false
    }
  }
}
