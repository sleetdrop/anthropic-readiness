{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "const": "W2"
    },
    "status": {
      "enum": [
        "incomplete",
        "complete"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_context": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "commit",
        "fingerprint",
        "image_context",
        "reviewed_head"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "full-source",
              "unit",
              "integration",
              "acceptance",
              "installed-packages",
              "frontend-static",
              "browser",
              "arm64-images",
              "amd64-images",
              "protected-contracts",
              "owned-cleanup",
              "preview",
              "independent-review",
              "remote-ci",
              "python-3.11",
              "native-amd64-development",
              "real-endpoint"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "identity_kind": {
            "enum": [
              "source",
              "image_context",
              "review",
              "none"
            ]
          },
          "source_identity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "executed": {
            "type": "boolean"
          },
          "unit": {
            "enum": [
              "tests",
              "checks",
              "observations",
              "reviews"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "required_children": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "not_run"
                  ]
                },
                "executed": {
                  "type": "boolean"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "status",
                "executed",
                "count"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "passed"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "executed": {
                        "const": true
                      },
                      "count": {
                        "minimum": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "identity_kind",
          "source_identity",
          "artifact",
          "sha256",
          "executed",
          "unit",
          "count",
          "required_children",
          "children",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "executed": {
                  "const": true
                },
                "count": {
                  "minimum": 1
                },
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_identity": {
                  "type": "string",
                  "minLength": 40
                },
                "identity_kind": {
                  "enum": [
                    "source",
                    "image_context",
                    "review"
                  ]
                },
                "children": {
                  "items": {
                    "properties": {
                      "status": {
                        "const": "passed"
                      },
                      "executed": {
                        "const": true
                      },
                      "count": {
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              }
            },
            "then": {
              "properties": {
                "executed": {
                  "const": false
                },
                "count": {
                  "const": 0
                },
                "artifact": {
                  "type": "null"
                },
                "sha256": {
                  "type": "null"
                },
                "source_identity": {
                  "type": "null"
                },
                "identity_kind": {
                  "const": "none"
                },
                "children": {
                  "maxItems": 0
                },
                "required_children": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "stage",
    "status",
    "source",
    "checks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
