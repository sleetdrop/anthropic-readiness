{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anthropic-readiness:imported-baseline:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "imported_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "artifact_root": {
      "$ref": "#/$defs/path"
    },
    "eligibility": {
      "$ref": "#/$defs/eligibility"
    },
    "evidence_verification": {
      "$ref": "#/$defs/evidence_quality"
    }
  },
  "required": [
    "schema_version",
    "id",
    "archive_sha256",
    "source",
    "imported_at",
    "artifact_root",
    "eligibility",
    "evidence_verification"
  ],
  "additionalProperties": false,
  "$defs": {
    "eligibility": {
      "type": "object",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "retest": {
          "type": "boolean"
        },
        "compare": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "read",
        "retest",
        "compare",
        "reasons"
      ],
      "additionalProperties": false
    },
    "evidence_quality": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "missing_or_invalid",
            "no_evidence"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "delivery": {
          "enum": [
            "external_files",
            "omitted"
          ]
        }
      },
      "required": [
        "status",
        "errors",
        "delivery"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "source": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "assessment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "result_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "assessment_id",
        "result_sha256",
        "checkpoint_sha256",
        "recipe_sha256",
        "context_sha256"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "result_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "properties": {
            "checkpoint_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
