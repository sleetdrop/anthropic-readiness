{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anthropic-readiness:diagnostic-import-preview:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expires_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "inventory": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "expanded_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "members": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              },
              "compressed_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              },
              "crc32": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes",
              "compressed_bytes",
              "crc32"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "archive_sha256",
        "bytes",
        "expanded_bytes",
        "members"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "preview_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "eligibility": {
          "$ref": "#/$defs/eligibility"
        },
        "evidence_verification": {
          "$ref": "#/$defs/evidence_quality"
        },
        "disclosures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_contains_target_context"
            ]
          }
        },
        "relationship": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "new",
                "identical",
                "variant",
                "conflict"
              ]
            },
            "baseline_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          },
          "required": [
            "kind",
            "baseline_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "preview_id",
        "expires_at",
        "source",
        "eligibility",
        "evidence_verification",
        "disclosures",
        "relationship"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "owner",
    "expires_at",
    "inventory",
    "response"
  ],
  "additionalProperties": false,
  "$defs": {
    "eligibility": {
      "type": "object",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "retest": {
          "type": "boolean"
        },
        "compare": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "read",
        "retest",
        "compare",
        "reasons"
      ],
      "additionalProperties": false
    },
    "evidence_quality": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "missing_or_invalid",
            "no_evidence"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "delivery": {
          "enum": [
            "external_files",
            "omitted"
          ]
        }
      },
      "required": [
        "status",
        "errors",
        "delivery"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "source": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "assessment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "result_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "assessment_id",
        "result_sha256",
        "checkpoint_sha256",
        "recipe_sha256",
        "context_sha256"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "result_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "properties": {
            "checkpoint_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
