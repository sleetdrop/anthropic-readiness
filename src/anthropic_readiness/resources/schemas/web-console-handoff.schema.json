{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "const": "W1"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "artifact": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "artifact",
          "sha256",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "enum": [
              "runtime",
              "web"
            ]
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "enum": [
              "native",
              "emulated",
              "not_run"
            ]
          }
        },
        "required": [
          "target",
          "platform",
          "digest",
          "execution"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "stage",
    "source_commit",
    "source_fingerprint",
    "lock_sha256",
    "toolchain_sha256",
    "checks",
    "images",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "enum": [
            "protocol",
            "behavior",
            "client",
            "environment"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "SKIP",
            "BLOCKED",
            "INDETERMINATE"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "event": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "pointer": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "event",
              "pointer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "version",
        "category",
        "required",
        "status",
        "reason_code",
        "expected",
        "actual",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "event",
        "pointer"
      ],
      "additionalProperties": false
    }
  }
}
