{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "type": "string"
    },
    "stage_readiness": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "source_fingerprint": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked"
            ]
          },
          "reason": {
            "type": "string"
          },
          "returncode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_s": {
            "type": "number",
            "minimum": 0
          },
          "log": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "argv",
          "required",
          "status",
          "reason",
          "returncode",
          "duration_s",
          "log",
          "started_at",
          "finished_at"
        ],
        "additionalProperties": false
      }
    },
    "finished_at": {
      "type": "string"
    },
    "source_unchanged": {
      "type": "boolean"
    },
    "lock_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "external_checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "not_run",
          "passed",
          "failed",
          "blocked"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "stage_readiness",
    "started_at",
    "source_fingerprint",
    "status",
    "checks",
    "finished_at",
    "source_unchanged",
    "lock_sha256",
    "tool_versions",
    "git",
    "external_checks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
