{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anthropic-readiness:export-manifest-v2:2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "presentation_version": {
      "const": "3.0"
    },
    "source_result_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "partial": {
      "type": "boolean"
    },
    "formats": {
      "type": "array",
      "items": {
        "enum": [
          "html",
          "markdown",
          "json",
          "zip"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "include_evidence": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "missing_or_invalid",
            "no_evidence"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery": {
          "enum": [
            "external_files",
            "omitted"
          ]
        }
      },
      "required": [
        "status",
        "errors"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    }
  },
  "required": [
    "schema_version",
    "export_id",
    "run_id",
    "created_at",
    "presentation_version",
    "source_result_sha256",
    "partial",
    "formats",
    "include_evidence",
    "files",
    "omissions",
    "evidence_verification",
    "presentation"
  ],
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "locale": {
          "enum": [
            "zh-CN",
            "en"
          ]
        },
        "theme": {
          "enum": [
            "light",
            "dark",
            "system"
          ]
        }
      },
      "required": [
        "schema_version",
        "locale",
        "theme"
      ],
      "additionalProperties": false
    }
  }
}
