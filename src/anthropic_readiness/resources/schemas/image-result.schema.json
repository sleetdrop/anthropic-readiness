{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "targets", "platform", "host_machine", "execution", "started_at", "finished_at", "image_context_fingerprint", "source_unchanged", "skip_build", "status", "error", "checks", "missing_checks"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "scope": {"enum": ["smoke", "full"]},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["runtime", "web"]}},
    "platform": {"enum": ["linux/amd64", "linux/arm64"]},
    "host_machine": {"type": "string"},
    "execution": {"enum": ["native", "emulated"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "image_context_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_unchanged": {"type": "boolean"},
    "skip_build": {"type": "boolean"},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "error": {"type": ["string", "null"]},
    "missing_checks": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"enum": ["passed", "failed", "blocked", "not_run"]}}}}
  }
}
