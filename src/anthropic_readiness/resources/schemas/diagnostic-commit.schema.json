{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anthropic-readiness:diagnostic-commit:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "baseline_sha256",
    "archive_sha256"
  ],
  "additionalProperties": false
}
