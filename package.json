{
  "name": "@sleetdrop/anthropic-readiness",
  "version": "0.1.0",
  "description": "Scaffold a portable agent workbench to assess an endpoint's Anthropic Messages protocol implementation.",
  "license": "MIT",
  "bin": {
    "anthropic-readiness": "./bin/anthropic-readiness.mjs"
  },
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "files": [
    "bin/",
    "templates/"
  ],
