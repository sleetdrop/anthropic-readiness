    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleetdrop/anthropic-readiness.git"
  },
  "bugs": {
