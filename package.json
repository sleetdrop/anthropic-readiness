{
  "name": "anthropic-readiness-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:lint": "eslint src/anthropic_readiness/resources tests/frontend tests/browser --no-error-on-unmatched-pattern",
    "check:format": "prettier --check package.json tsconfig.json '*.config.js' 'src/anthropic_readiness/resources/{web/**/*,report-v2}.{html,css,js}' 'tests/{frontend,browser}/**/*.js'",
    "test:unit": "node --test tests/frontend/*.test.js",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
